# Copy to .env and change every secret before any non-local use.
POSTGRES_USER=ssddh
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=ssddh
DATABASE_URL=postgresql+psycopg://ssddh:change-me-db-password@db:5432/ssddh

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-long-random-string
ACCESS_TOKEN_MINUTES=60

# First admin is created from these values by `python -m app.seed --admin-only`
BOOTSTRAP_ADMIN_EMAIL=admin@example.org
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password

CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10

# File storage: local folder by default, MinIO/S3 if S3_ENDPOINT is set
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=10
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=ssddh

# Optional local LLM. Leave OLLAMA_URL empty to use extractive (no-LLM) answers.
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b

# Admin dashboard
NEXT_PUBLIC_API_URL=http://localhost:8000
