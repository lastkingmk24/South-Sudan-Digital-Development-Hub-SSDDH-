{
  "id": "./",
  "name": "South Sudan Digital Development Hub",
  "short_name": "SSDDH",
  "description": "Offline-first directory of verified public services, community issue reporting and a citation-gated information assistant for South Sudan. Synthetic demo data.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./#/home",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "background_color": "#f4f7f4",
  "theme_color": "#0f6b46",
  "categories": ["government", "education", "utilities", "health"],
  "icons": [
    {
      "src": "assets/img/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/img/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/img/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "assets/img/logo.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Find a service",
      "short_name": "Services",
      "url": "./#/services",
      "icons": [{ "src": "assets/img/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Report an issue",
      "short_name": "Report",
      "url": "./#/report",
      "icons": [{ "src": "assets/img/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Ask the assistant",
      "short_name": "Assistant",
      "url": "./#/assistant",
      "icons": [{ "src": "assets/img/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "prefer_related_applications": false
}
